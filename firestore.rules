rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validListing() {
      return request.resource.data.keys().hasOnly(['ownerId','name','category','hometown','service_areas','description','phone','whatsapp','website','address','status','createdAt','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.service_areas is list
        && request.resource.data.service_areas.size() <= 20;
    }
    match /heriland_businesses/{id} {
      allow get, list: if resource.data.status == 'approved'
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && validListing()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status == 'pending'
        && validListing();
      allow delete: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}