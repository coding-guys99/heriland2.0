rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/heriland_admins/$(request.auth.uid)); }
    function validListing() {
      return request.resource.data.keys().hasOnly(['ownerId','name','category','hometown','service_areas','description','phone','whatsapp','website','address','status','createdAt','updatedAt','reviewReason'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.service_areas is list
        && request.resource.data.service_areas.size() <= 20
        && (!('reviewReason' in request.resource.data) || (request.resource.data.reviewReason is string && request.resource.data.reviewReason.size() <= 500));
    }
    match /heriland_admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /heriland_profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['type','name','phone','company','ssm','updatedAt'])
        && request.resource.data.type in ['individual','company']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.company is string
        && request.resource.data.company.size() <= 120
        && request.resource.data.ssm is string
        && request.resource.data.ssm.size() <= 60;
      allow delete: if false;
    }
    match /heriland_businesses/{id} {
      allow get, list: if resource.data.status == 'approved'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();
      allow create: if signedIn()
        && validListing()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if
        (signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status == 'pending'
          && validListing())
        || (isAdmin()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status in ['pending','approved','rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','reviewReason']));
      allow delete: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}